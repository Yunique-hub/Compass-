{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserProfile",
  "type": "object",
  "required": ["user_id"],
  "properties": {
    "user_id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "major": {"type": "string"},
    "secondary_major": {"type": "string"},
    "minor": {"type": "string"},
    "previous_majors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "academic_profile": {
      "type": "object",
      "required": ["raw_major", "normalized_major", "discipline_family", "profile_source"],
      "properties": {
        "raw_major": {"type": "string"},
        "normalized_major": {"type": "string"},
        "discipline_family": {"type": "string", "minLength": 1},
        "taxonomy_domain": {"type": "string", "minLength": 1},
        "specialization": {"type": "string"},
        "degree_level": {"type": "string"},
        "academic_year": {"type": "string"},
        "secondary_major": {"type": "string"},
        "minor": {"type": "string"},
        "previous_majors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "transition_target": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "profile_source": {"enum": ["explicit", "user_confirmed", "curated", "family_fallback", "fallback"]},
        "knowledge_source": {"enum": ["curated", "family_fallback", "fallback"]},
        "major_status": {"enum": ["confirmed", "candidate", "unknown"]},
        "learning_domain": {"type": "string"},
        "current_topic": {"type": "string"}
      },
      "additionalProperties": true
    },
    "grade": {"type": "string"},
    "verified_skills": {"type": "array", "items": {"type": "object"}},
    "weekly_hours": {"type": "number", "minimum": 0},
    "known_facts": {"type": "object"},
    "pending_confirmations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
