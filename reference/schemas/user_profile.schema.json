{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserProfile",
  "type": "object",
  "required": ["user_id"],
  "properties": {
    "user_id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "major": {"type": "string"},
    "grade": {"type": "string"},
    "verified_skills": {"type": "array", "items": {"type": "object"}},
    "weekly_hours": {"type": "number", "minimum": 0},
    "known_facts": {"type": "object"},
    "pending_confirmations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
